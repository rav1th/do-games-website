<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Do Games - Play More. Win More.</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <nav>
            <div class="logo">Do Games</div>
            <ul>
                <li><a href="#hero">Home</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#how-it-works">How It Works</a></li>
                <li><a href="#stats">Stats</a></li>
                <li><a href="#testimonials">Testimonials</a></li>
            </ul>
        </nav>
    </header>

    <section id="hero">
        <div class="hero-content">
            <h1>Do Games. Play More. Win More.</h1>
            <p>Do Games helps players and creators discover, build, and grow powerful gaming experiences.</p>
            <div class="cta-buttons">
                <button class="primary-btn">Get Started</button>
                <button class="secondary-btn">Explore Games</button>
            </div>
        </div>
        <div class="hero-bg"></div>
    </section>

    <section id="features">
        <h2>Features</h2>
        <div class="features-grid">
            <div class="feature-card">
                <h3>Discover Trending Games</h3>
                <p>Explore the latest hits and hidden gems in gaming.</p>
            </div>
            <div class="feature-card">
                <h3>Track Performance & Stats</h3>
                <p>Monitor your progress and compete with the best.</p>
            </div>
            <div class="feature-card">
                <h3>Build and Launch Your Own Games</h3>
                <p>Create indie games or Roblox experiences effortlessly.</p>
            </div>
            <div class="feature-card">
                <h3>Grow Communities</h3>
                <p>Connect with players and build thriving gaming communities.</p>
            </div>
        </div>
    </section>

    <section id="how-it-works">
        <h2>How It Works</h2>
        <div class="steps">
            <div class="step">
                <div class="step-number">1</div>
                <h3>Sign Up</h3>
                <p>Create your account and join the community.</p>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <h3>Discover & Play</h3>
                <p>Find games, track stats, and start playing.</p>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <h3>Build & Grow</h3>
                <p>Launch your creations and expand your reach.</p>
            </div>
        </div>
    </section>

    <section id="stats">
        <h2>Our Impact</h2>
        <div class="stats-grid">
            <div class="stat">
                <h3>1M+</h3>
                <p>Active Users</p>
            </div>
            <div class="stat">
                <h3>10K+</h3>
                <p>Games Created</p>
            </div>
            <div class="stat">
                <h3>50M+</h3>
                <p>Gaming Sessions</p>
            </div>
        </div>
    </section>

    <section id="testimonials">
        <h2>What Gamers Say</h2>
        <div class="testimonials-grid">
            <div class="testimonial">
                <p>"Do Games transformed my gaming experience. I discovered so many amazing titles!"</p>
                <cite>- Alex, Competitive Player</cite>
            </div>
            <div class="testimonial">
                <p>"As a developer, the tools here are top-notch. Launched my first Roblox game in no time."</p>
                <cite>- Jordan, Indie Creator</cite>
            </div>
            <div class="testimonial">
                <p>"Tracking stats has never been easier. I feel like a pro now!"</p>
                <cite>- Taylor, Gamer</cite>
            </div>
        </div>
    </section>

    <section id="final-cta">
        <h2>Ready to Level Up?</h2>
        <p>Join Do Games today and start your journey.</p>
        <button class="primary-btn">Get Started Now</button>
    </section>

    <footer>
        <div class="footer-content">
            <div class="logo">Do Games</div>
            <ul>
                <li><a href="#">Privacy Policy</a></li>
                <li><a href="#">Terms of Service</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </div>
        <p>&copy; 2023 Do Games. All rights reserved.</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
